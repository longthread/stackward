#!/bin/sh
# Refuse to push anything containing a denied term.
#
# CI checks the same thing, but CI runs *after* a commit exists. On a public
# repository that is too late: by the time the job goes red the content is
# already published, and editing it out afterwards does not unpublish it. This
# hook is the only layer that can actually prevent the leak, because it runs
# before anything leaves the machine.
#
# The list is not stored in this repository — it names the very things it
# blocks. Point the hook at your copy:
#
#     export STACKWARD_DENYLIST=/path/to/denylist.txt
#
# or place it at .git/neutrality-denylist.txt, which git never tracks. Install
# with scripts/install-hooks.sh.
#
# Blank lines and #-comments are ignored, matching the CI job.
set -eu

REMOTE_NAME="${1:-origin}"
ZERO="0000000000000000000000000000000000000000"

LIST="${STACKWARD_DENYLIST:-$(git rev-parse --git-dir)/neutrality-denylist.txt}"
if [ ! -f "$LIST" ]; then
  cat >&2 <<EOF
pre-push: no denylist found at
  $LIST

Refusing to push. This check cannot pass by default: a gate that silently
skips when its policy is missing is worse than no gate, because it looks like
protection. Set STACKWARD_DENYLIST or run scripts/install-hooks.sh.
EOF
  exit 1
fi

PARSED="$(mktemp)"
trap 'rm -f "$PARSED"' EXIT
sed 's/[[:space:]]*#.*$//' "$LIST" | grep -v '^[[:space:]]*$' > "$PARSED"
[ -s "$PARSED" ] || { echo "pre-push: denylist is empty after parsing — refusing" >&2; exit 1; }

fail=0
while read -r _localref localsha _remoteref remotesha; do
  [ "$localsha" = "$ZERO" ] && continue   # branch deletion

  if [ "$remotesha" = "$ZERO" ]; then
    # New branch: everything on it that the remote does not already have.
    commits="$(git rev-list "$localsha" --not --remotes="$REMOTE_NAME" 2>/dev/null || git rev-list "$localsha")"
  else
    commits="$(git rev-list "$remotesha..$localsha")"
  fi
  [ -n "$commits" ] || continue

  # Every commit in the range, not just the tip: a term added and removed
  # within the pushed range is still published in the history.
  # shellcheck disable=SC2086
  if git grep -I -i -l -F -f "$PARSED" $commits -- . > /tmp/stackward-hits 2>/dev/null; then
    echo "pre-push: denied term found in commits being pushed:" >&2
    # Locations only, never the match — printing it would disclose the term.
    sort -u /tmp/stackward-hits | sed 's/^/  /' >&2
    fail=1
  fi
  rm -f /tmp/stackward-hits

  # shellcheck disable=SC2086
  if git log --format='%B' $commits | grep -I -i -q -F -f "$PARSED"; then
    echo "pre-push: denied term found in a commit message being pushed." >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'EOF'

Push refused. This repository is public and its history is permanent, so a
denied term cannot be removed by a later commit — rewrite the history now,
before it is published.

If this is a false positive, correct the denylist rather than bypassing:
--no-verify publishes it.
EOF
  exit 1
fi
exit 0
